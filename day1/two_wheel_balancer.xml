<mujoco model="two_wheel_balancer">
  <compiler angle="radian" coordinate="local" inertiafromgeom="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" iterations="50" integrator="RK4"/>
  <size njmax="2000" nconmax="2000"/>

  <default>
    <!-- General -->
    <geom contype="1" conaffinity="1" rgba="0.7 0.7 0.7 1" friction="1.2 0.02 0.001"/>
    <joint damping="0.02" armature="0.002"/>
    <motor ctrllimited="true" ctrlrange="-25 25"/>
  </default>

  <worldbody>
    <!-- Ground -->
    <geom name="floor" type="plane" pos="0 0 0" size="20 20 0.1" rgba="0.2 0.2 0.2 1"
          friction="1.5 0.02 0.001"/>
    <!-- Lighting -->
    <light name="sun" pos="0 0 5" dir="0 0 -1" directional="true"
           diffuse="1 1 1" specular="0.2 0.2 0.2" castshadow="true"/>
    <light name="fill" pos="2 2 2" dir="-1 -1 -1" directional="true"
       diffuse="0.4 0.4 0.4" specular="0 0 0" castshadow="false"/>
    <!-- Robot base frame -->
    <!-- Place COM above wheels so it behaves like an inverted pendulum on wheels -->
    <body name="robot" pos="0 0 0">
      <!-- Free joint: robot can move and rotate in 3D -->
      <freejoint name="root"/>

      <!-- Chassis: a box above wheels -->
      <geom name="chassis" type="box" pos="0 0 0.10" size="0.08 0.05 0.02"
            density="600" rgba="0.3 0.45 0.9 1"/>

      <!-- Gyroscope module (replaces top mass) -->
      <geom name="gyro_module" type="cylinder" pos="0 0 0.15"
            euler="1.57079632679 0 0" size="0.03 0.015"
            density="550" rgba="0.95 0.65 0.2 1"/>

      <!-- Left wheel -->
    <body name="wheel_L" pos="0 -0.07 0.07">
    <!-- axle along Y (left-right), wheel rolls along X -->
    <joint name="wheel_L_hinge" type="hinge" pos="0 0 0" axis="0 1 0"
           limited="false" damping="0.08" armature="0.01"/>
    <!-- cylinder axis is local Z by default, rotate geom so its axis aligns with Y -->
    <geom name="wheel_L_geom" type="cylinder"
        euler="1.57079632679 0 0"
        size="0.07 0.018"
        density="800"
        rgba="0.1 0.1 0.1 1"
        friction="2.0 0.02 0.001"/>
</body>

<!-- Right wheel -->
<body name="wheel_R" pos="0 0.07 0.07">
  <joint name="wheel_R_hinge" type="hinge" pos="0 0 0" axis="0 1 0"
         limited="false" damping="0.08" armature="0.01"/>
  <geom name="wheel_R_geom" type="cylinder"
        euler="1.57079632679 0 0"
        size="0.07 0.018"
        density="800"
        rgba="0.1 0.1 0.1 1"
        friction="2.0 0.02 0.001"/>
</body>

      <!-- Optional: a small caster / skid to prevent endless rolling on pitch extremes (comment out if not needed) -->
      <!--
      <geom name="skid" type="sphere" pos="-0.10 0 0.03" size="0.015" density="300"
            rgba="0.8 0.2 0.2 1" friction="1.0 0.02 0.001"/>
      -->

      <!-- Sites for debugging / sensors -->
      <site name="imu_site" pos="0 0 0.15" size="0.008" rgba="1 0.5 0 1"/>
      <site name="com_site" pos="0 0 0.18" size="0.01" rgba="1 0 0 1"/>
    </body>
  </worldbody>

  <actuator>
    <!-- Left / right wheel motors -->
    <motor name="left_wheel_motor" joint="wheel_L_hinge" gear="1.5"/>
    <motor name="right_wheel_motor" joint="wheel_R_hinge" gear="1.5"/>
  </actuator>

  <sensor>
    <!-- Useful for RL observation -->
    <framequat name="base_quat" objtype="body" objname="robot"/>
    <framelinvel name="base_linvel" objtype="body" objname="robot"/>
    <frameangvel name="base_angvel" objtype="body" objname="robot"/>
    <gyro name="imu_gyro" site="imu_site"/>

    <jointpos name="q_wheel_L" joint="wheel_L_hinge"/>
    <jointvel name="qd_wheel_L" joint="wheel_L_hinge"/>
    <jointpos name="q_wheel_R" joint="wheel_R_hinge"/>
    <jointvel name="qd_wheel_R" joint="wheel_R_hinge"/>

    <!-- Contact force on chassis (rough indicator of fall/impact) -->
    <touch name="touch_chassis" site="com_site"/>
  </sensor>
</mujoco>
